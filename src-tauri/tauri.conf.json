{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HND生产助手",
  "version": "1.0.20",
  "identifier": "cloud.hbhnd.hnd-factory",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9091",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HND生产助手",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://hbhnd.cloud/desktop/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4OTU0MjU4NUE1MEE5QzcKUldUSHFWQmFXRUtWcUh4TnYxOGkvU2ptZmJJYmR4NGVZQ2R2Sm5zOGVMM0VYaSt0dWFxRVVOOGYK"
    }
  }
}
