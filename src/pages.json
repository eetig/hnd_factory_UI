{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "HND生产助手",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/register/register",
      "style": {
        "navigationBarTitleText": "注册"
      }
    },
    {
      "path": "pages/meterRead/meterRead",
      "style": {
        "navigationBarTitleText": "抄表"
      }
    },
    {
      "path": "pages/electricity/electricity",
      "style": {
        "navigationBarTitleText": "电费"
      }
    },
    {
      "path": "pages/auditLog/auditLog",
      "style": {
        "navigationBarTitleText": "管控日志"
      }
    },
    {
      "path": "pages/privacy/privacy",
      "style": {
        "navigationBarTitleText": "隐私政策"
      }
    },
    {
      "path": "pages/pickParse/pickParse",
      "style": {
        "navigationBarTitleText": "领料解析"
      }
    },
    {
      "path": "pages/userAdmin/userAdmin",
      "style": {
        "navigationBarTitleText": "用户名单"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "HND生产助手",
    "navigationBarBackgroundColor": "#F2F3F7",
    "backgroundColor": "#F2F3F7",
    "backgroundColorTop": "#F2F3F7",
    "backgroundColorBottom": "#F2F3F7"
  }
}
